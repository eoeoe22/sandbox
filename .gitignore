# build output
dist/
.astro/

# rust wasm build output (the committed artifact is src/game/engine/heat.wasm)
wasm/heat/target/

# dependencies
node_modules/

# cloudflare / wrangler
.wrangler/

# logs & os
*.log
.DS_Store
npm-debug.log*

# Claude Code local tooling scratch space (e.g. isolated agent worktrees).
# `.claude/skills/` is the exception — those are checked-in project documents
# (see CLAUDE.md "# 스킬"), so exclude the directory's contents rather than the
# directory itself, or git would never descend far enough to see the negation.
.claude/*
!.claude/skills/

# Throwaway probe harnesses. The review step in CLAUDE.md's workflow spawns
# subagents that write one-shot scenes to measure a claim ("does rule A really
# beat rule B?") and then discard them — twice now they have been left behind as
# untracked files. Real harnesses are `test/<name>.ts` + `test/run-<name>.mjs`
# and are wired into `npm test`; anything prefixed with `_` is scratch by
# convention and must never be committed.
test/_*
test/run-_*
