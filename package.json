{
  "name": "sandbox",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check:material-ids": "node scripts/check-material-ids.mjs",
    "build": "npm run check:material-ids && npm run check:hand-icons && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "test:heat": "node wasm/test/golden.mjs && node wasm/test/integration.mjs",
    "test:active-tiles": "node test/run-active-tiles.mjs",
    "test:electricity": "node test/run-electricity.mjs",
    "test:snapshot-file": "node test/run-snapshot-file.mjs",
    "test:woodbox": "node test/run-woodbox.mjs",
    "test:fireworks": "node test/run-fireworks.mjs",
    "test:aluminum": "node test/run-aluminum.mjs",
    "test:plantcoral": "node test/run-plantcoral.mjs",
    "test:plastic": "node test/run-plastic.mjs",
    "test:magnetobjects": "node test/run-magnetobjects.mjs",
    "test:smokebomb": "node test/run-smokebomb.mjs",
    "test:materialicons": "node test/run-materialicons.mjs",
    "test:acidmetal": "node test/run-acidmetal.mjs",
    "test": "npm run test:heat && npm run test:active-tiles && npm run test:electricity && npm run test:snapshot-file && npm run test:woodbox && npm run test:fireworks && npm run test:aluminum && npm run test:plantcoral && npm run test:plastic && npm run test:magnetobjects && npm run test:smokebomb && npm run test:materialicons && npm run test:acidmetal",
    "check:hand-icons": "node scripts/build-hand-icons.mjs --check",
    "build:hand-icons": "node scripts/build-hand-icons.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.0.6",
    "nanostores": "^1.4.0",
    "svelte": "^5.56.4",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  }
}
