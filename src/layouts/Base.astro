---
import '../styles/global.css';
import faviconUrl from '../assets/favicon.svg?url';

interface Props {
  title?: string;
  /**
   * This page *is* the sandbox app — it paints a canvas the user drags and
   * pinches on. Both of the gestures a browser normally spends on the document
   * get taken away from it:
   *
   * - the document scroller (`global.css` locks `html, body` to
   *   `overflow: hidden`), so a touch drag paints instead of scrolling and the
   *   address bar never collapses out from under a `dvh`-sized canvas (see the
   *   `#game` note there);
   * - pinch zoom (`maximum-scale=1, user-scalable=no`), so a two-finger gesture
   *   over the play area doesn't zoom the page instead of doing whatever the
   *   canvas wants. `touch-action: none` covers `#game` itself, but the sidebar
   *   and the bottom bar around it are outside the canvas.
   *
   * **Off by default**, so a page that is only text — the codex, the 404 —
   * scrolls and zooms like any other web page. The default is this way round
   * because the opposite one has now gone wrong twice: `/guide` shipped unable
   * to scroll at all (the content below the fold was simply unreachable on a
   * phone), and then shipped again refusing to pinch-zoom 11px badge text,
   * which is a WCAG 1.4.4 failure that only Android shows — iOS Safari has
   * ignored `user-scalable=no` since iOS 10, so testing on an iPhone hides it.
   * A page that forgets to opt in now merely looks like a document.
   */
  app?: boolean;
}
const { title = 'Particle Sandbox', app = false } = Astro.props;
---

<!doctype html>
<html lang="ko" class={app ? undefined : 'scrollable'}>
  <head>
    <meta charset="utf-8" />
    <!-- Detect the UI locale before first paint so <html lang> and any
         pre-hydration text match the user's choice (persisted locale wins,
         otherwise browser language; defaults to Korean). Runs inline in <head>
         so it applies before the body renders. Mirrors src/i18n's detectLocale
         and persistence key. -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('particle-sandbox:settings:v1');
          var saved = raw ? JSON.parse(raw).locale : null;
          var loc = saved;
          if (loc !== 'ko' && loc !== 'en') {
            var langs = navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language];
            loc = 'ko';
            for (var i = 0; i < langs.length; i++) {
              if (!langs[i]) continue;
              var l = langs[i].toLowerCase();
              if (l.indexOf('ko') === 0) { loc = 'ko'; break; }
              if (l.indexOf('en') === 0) { loc = 'en'; break; }
            }
          }
          document.documentElement.lang = loc;
        } catch (e) {}
      })();
    </script>
    <!-- The zoom clamp is the app's, not every page's — see the `app` prop.
         Both halves have to go for a document page: either one alone still
         clamps Chrome. -->
    <meta
      name="viewport"
      content={app
        ? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
        : 'width=device-width, initial-scale=1'}
    />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <!-- manifest.webmanifest, /icons/*, /sw.js는 public/에서 해시 없이 그대로
         배포된다(PWA 설치·서비스 워커는 고정 URL이 필요 — docs/PWA.md 참고). -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#101014" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Sandbox" />
    <!-- Only the Bootstrap Icons webfont is used (bi-* glyphs in the control
         panel). The full Bootstrap CSS isn't loaded — the app uses no Bootstrap
         component classes and global.css owns the reset/base styles.

         The stylesheet is render-blocking and the font inside it is only
         discovered once it parses, so on a cold mobile connection that is two
         serial round trips before any glyph exists (`font-display: block` in a
         third-party stylesheet we can't change means they stay invisible, not
         fallback-rendered, until then). The preconnect gets the DNS + TLS
         handshake out of the way in parallel with the HTML; `crossorigin` is
         required for it to be reused by the font fetch. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // 프로덕션 빌드에서만 등록 — `astro dev`에서는 SW 캐시가 개발 중 파일
      // 변경을 가리는 걸 막기 위해 건너뛴다. sw.js는 public/에서 해시 없이
      // 고정 경로로 나가므로 등록 URL도 고정 문자열이어야 한다(docs/PWA.md).
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
  </body>
</html>
