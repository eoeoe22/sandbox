---
// 물질 도감 — generated at build time from the live material registry.
//
// Everything below the layout runs once, here, in Node: `buildCodexEntries`
// imports the registry and reduces every palette material to plain data, and
// `buildIconSprite` renders each material's palette chip into a `<symbol>`. The
// browser gets the data as island props and the drawings as one sprite; the
// simulation itself never crosses over, so the guide page stays a static
// document that happens to be searchable.
//
// The page's visible text is all inside the island — see Codex.svelte's note on
// why the heading lives there rather than here.
import Base from '../layouts/Base.astro';
import Codex from '../components/Codex.svelte';
import { buildCodexEntries } from '../game/codex/entries';
import { buildObjectEntries } from '../game/codex/objects';
import { buildIconSprite } from '../game/codex/icons';

const materials = buildCodexEntries();
const objects = buildObjectEntries();
const sprite = buildIconSprite();
---

<Base title="Particle Sandbox - 물질 도감">
  <div class="guide-page">
    <Codex client:load materials={materials} objects={objects} />
    <!-- The icon definitions, once per document. Every `<use href="#codex-…">`
         in the grid and the detail view points in here.

         Last, not first: this is ~220 KB of inert `<path>` data, and in front of
         the island it was 220 KB the parser had to get through before it reached
         a single visible element — the page stayed blank for all of it. `<use>`
         resolves a forward reference when the target is inserted, and `.icon` /
         `.hero` are fixed-size boxes, so the drawings fill in a moment later
         with no reflow. -->
    <Fragment set:html={sprite} />
  </div>
</Base>

<style>
  .guide-page {
    /* Enough to paint the whole screen when the grid is short (a search that
       matched nothing). dvh over vh for the usual mobile reason — vh is the
       large viewport, so it would reserve a screenful *plus* the address bar's
       height and leave a stripe of scroll under a page that fits. */
    min-height: 100vh;
    min-height: 100dvh;
    background: #0b0c10;
    color: #e0e6ed;
    padding: 2rem 1.5rem 3rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  @media (max-width: 520px) {
    .guide-page {
      padding: 1.25rem 1rem 2rem;
    }
  }
</style>
