---
// 루트(`/`)는 소개 페이지가 아니라 **게임 시작 화면**이다: 한 화면에 담기고,
// 스크롤이 없고, 타이틀과 메뉴 한 줄기만 있다. 배경에서는 진짜 엔진이 혼자
// 돌아간다(StartScreenSandbox) — 물질이 떨어지고 1초마다 불이나 충격파가 터진다.
//
// 타이틀은 정적 HTML로 두고(첫 페인트·검색엔진), 상호작용이 필요한 조각만
// 섬으로 띄운다.
import Base from '../layouts/Base.astro';
import StartScreenSandbox from '../components/StartScreenSandbox.svelte';
import StartMenu from '../components/StartMenu.svelte';
import { WATER } from '../game/materials/water';
import { SAND } from '../game/materials/sand';
import { titleTileUrl } from '../game/render/titleTile';

// 타이틀 두 줄을 칠할 픽셀 틴트 타일. 빌드 타임에 한 번 만들어져 문자열로 박히므로
// 런타임 비용은 0이고, 색과 결은 물·모래의 `Material` 정의에서 직접 나온다 — 물질
// 색이나 틴트 진폭을 손보면 타이틀이 따라온다.
//
// 스타일시트가 아니라 `style` 속성으로 넣는 이유: Astro의 `<style>` 블록은 정적
// 텍스트라 표현식을 받지 못한다. `define:vars`가 그 우회로지만, 이 페이지의 루트는
// 컴포넌트(`<Base>`)라 변수가 어디에 얹히는지가 레이아웃 구조에 딸려 가므로 쓰지
// 않는다. 나머지 배경 속성은 전부 아래 스타일 블록에 있다.
const waterTile = titleTileUrl(WATER);
const sandTile = titleTileUrl(SAND);
---

<Base title="Particle Sandbox">
  <div class="screen">
    <StartScreenSandbox client:load />

    <div class="foreground">
      <main class="center">
        <h1 class="title">
          <span class="line" style={`background-image: ${waterTile}`}>PARTICLE</span>
          <span class="line" style={`background-image: ${sandTile}`}>SANDBOX</span>
        </h1>
        <StartMenu client:load />
      </main>

      <footer class="foot">
        <span>© 2026 Particle Sandbox</span>
      </footer>
    </div>
  </div>
</Base>

<style>
  .screen {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #08080c;
    color: #f1f5f9;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .foreground {
    position: relative;
    z-index: 5;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .center {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* 타이틀과 메뉴 사이의 숨. 예전엔 타이틀 밑 태그라인의 아래 여백이 하던
       몫이라, 그 줄을 걷어내면서 여기로 옮겨 왔다. */
    gap: 1.4rem;
    padding: 0 1.2rem;
    text-align: center;
  }

  .title {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 0.95;
    font-size: clamp(2.6rem, 9vw, 4.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    /* 글자 자체가 반투명(background-clip: text)이라 text-shadow를 쓰면 그림자가
       글자 **속으로** 비쳐 색이 탁해진다. 합성 결과에 걸리는 drop-shadow로 뺀다. */
    filter: drop-shadow(0 2px 16px rgba(0, 0, 0, 0.85));
  }

  /* 타이틀 두 줄은 자기가 이름 붙인 물질로 칠한다: 위는 Water, 아래는 Sand.
     색만이 아니라 **칠하는 방식까지** 캔버스와 같다 — 평면 기본색 위에 셀별
     밝기 틴트를 얹은 픽셀 패턴이고, 타일은 렌더러와 같은 산술로 빌드 타임에
     만들어진다(`game/render/titleTile.ts`, 물질별 결이 왜 다른지도 거기 있다).
     세로 그라디언트로 칠하던 예전 판은 이 게임이 그리지 않는 그림이었다.

     두 줄의 규칙이 완전히 같아서 클래스도 하나다 — 어느 물질을 쓰는지는
     마크업의 `background-image` 한 줄이 말한다(프런트매터 주석 참고).
     셀 한 칸은 0.1em이라 글자 크기를 따라 같이 커진다 — 화면이 좁아져도
     "몇 칸짜리 글자"라는 인상이 그대로다. */
  .line {
    /* 16셀 × 0.1em. 앞의 16은 `TITLE_TILE_CELLS`와 짝이다. */
    background-size: 1.6em 1.6em;
    background-repeat: repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    /* 타일을 원본 해상도로 래스터화한 뒤 늘리는 브라우저에서도 셀이 뭉개지지
       않게 하는 보험. 벡터로 그리는 쪽은 SVG의 `shape-rendering="crispEdges"`가
       같은 일을 이미 한다. */
    image-rendering: pixelated;
  }

  .foot {
    flex: none;
    padding: 1.1rem 1.4rem;
    font-size: 0.72rem;
    color: #475569;
  }

  @media (max-width: 480px) {
    .center {
      gap: 1rem;
    }
    .foot {
      padding: 0.9rem 1rem;
    }
  }
</style>
