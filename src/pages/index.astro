---
import Base from '../layouts/Base.astro';
import HeroSandbox from '../components/HeroSandbox.svelte';
import SnapshotManagerModal from '../components/SnapshotManagerModal.svelte';
---

<Base title="Particle Sandbox">
  <div class="landing-container">
    <!-- Dynamic Hero Particle Background -->
    <HeroSandbox client:load />

    <!-- Main Menu -->
    <main class="menu-content">
      <div class="menu-block">
        <h1 class="main-title">
          <span class="glow-text">PARTICLE</span>
          <span class="accent-text">SANDBOX</span>
        </h1>

        <!-- Menu Buttons -->
        <div class="menu-group">
          <a href="/sandbox" class="btn-menu">
            <i class="bi bi-play-fill"></i>
            <span>게임 시작</span>
          </a>

          <button id="open-snapshot-btn" class="btn-menu">
            <i class="bi bi-restore"></i>
            <span>불러오기 / 스냅샷 관리</span>
          </button>

          <a href="/guide" class="btn-menu">
            <i class="bi bi-journal-bookmark-fill"></i>
            <span>도감 & 가이드</span>
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="landing-footer">
      <p>© 2026 Particle Sandbox Project.</p>
    </footer>

    <!-- Interactive Snapshot Manager Modal container -->
    <div id="snapshot-modal-root"></div>
  </div>
</Base>

<script>
  // Mount interactive modal handler for snapshot button
  import { mount } from 'svelte';
  import SnapshotManagerModal from '../components/SnapshotManagerModal.svelte';

  const btn = document.getElementById('open-snapshot-btn');
  const root = document.getElementById('snapshot-modal-root');

  if (btn && root) {
    let isOpen = false;

    function renderModal() {
      if (!root) return;
      root.innerHTML = '';
      mount(SnapshotManagerModal, {
        target: root,
        props: {
          isOpen,
          onClose: () => {
            isOpen = false;
            renderModal();
          },
        },
      });
    }

    btn.addEventListener('click', () => {
      isOpen = true;
      renderModal();
    });
  }
</script>

<style>
  .landing-container {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    background: #0a0a0e;
    color: #f1f5f9;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* Main Menu Content */
  .menu-content {
    position: relative;
    z-index: 5;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }

  .menu-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .main-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .glow-text {
    color: #f8fafc;
    text-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
    letter-spacing: 0.1em;
  }

  .accent-text {
    background: linear-gradient(135deg, #00d4ff 0%, #0088cc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: clamp(2rem, 5vw, 4rem);
    letter-spacing: 0.4em;
    margin-top: -0.2em;
    text-shadow: 0 0 30px rgba(0, 212, 255, 0.6);
  }

  /* Menu Buttons Group */
  .menu-group {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 320px;
  }

  .btn-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.2rem 2rem;
    font-size: 1.2rem;
    font-weight: 600;
    color: #00d4ff;
    text-decoration: none;
    border-radius: 0.5rem;
    background: rgba(20, 20, 20, 0.6);
    border: 1px solid rgba(0, 212, 255, 0.3);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 0 15px rgba(0, 212, 255, 0);
  }

  .btn-menu:hover {
    background: rgba(30, 41, 59, 0.8);
    color: #fff;
    border-color: #00d4ff;
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.4), inset 0 0 10px rgba(0, 212, 255, 0.2);
    transform: translateY(-2px);
  }

  .btn-menu i {
    font-size: 1.4rem;
  }

  /* Footer */
  .landing-footer {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 1rem;
    font-size: 0.8rem;
    color: rgba(100, 116, 139, 0.6);
  }
</style>
