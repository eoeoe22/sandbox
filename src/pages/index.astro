---
// 루트(`/`)는 소개 페이지가 아니라 **게임 시작 화면**이다: 한 화면에 담기고,
// 스크롤이 없고, 타이틀과 메뉴 한 줄기만 있다. 배경에서는 진짜 엔진이 혼자
// 돌아간다(StartScreenSandbox) — 물질이 떨어지고 1초마다 불이나 충격파가 터진다.
//
// 타이틀/태그라인은 정적 HTML로 두고(첫 페인트·검색엔진), 상호작용이 필요한
// 두 조각만 섬으로 띄운다.
import Base from '../layouts/Base.astro';
import StartScreenSandbox from '../components/StartScreenSandbox.svelte';
import StartMenu from '../components/StartMenu.svelte';
---

<Base title="Particle Sandbox — 웹 파티클 물리·화학 샌드박스">
  <div class="screen">
    <StartScreenSandbox client:load />

    <div class="foreground">
      <header class="brand">
        <span class="mark">PARTICLE</span>
        <span class="tag">SANDBOX</span>
      </header>

      <main class="center">
        <h1 class="title">
          <span class="line-1">PARTICLE</span>
          <span class="line-2">SANDBOX</span>
        </h1>
        <p class="tagline">브라우저에서 도는 파티클 물리·화학 샌드박스</p>
        <StartMenu client:load />
      </main>

      <footer class="foot">
        <span>© 2026 Particle Sandbox</span>
      </footer>
    </div>
  </div>
</Base>

<style>
  .screen {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #08080c;
    color: #f1f5f9;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .foreground {
    position: relative;
    z-index: 5;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .brand {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 1.1rem 1.4rem;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .mark {
    color: #e2e8f0;
  }

  .tag {
    padding: 0.15rem 0.4rem;
    border-radius: 0.3rem;
    background: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%);
    color: #fff;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .center {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1.2rem;
    text-align: center;
  }

  .title {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 0.95;
    font-size: clamp(2.6rem, 9vw, 4.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    /* 글자 자체가 반투명(background-clip: text)이라 text-shadow를 쓰면 그림자가
       글자 **속으로** 비쳐 색이 탁해진다. 합성 결과에 걸리는 drop-shadow로 뺀다. */
    filter: drop-shadow(0 2px 16px rgba(0, 0, 0, 0.85));
  }

  /* 타이틀 두 줄은 게임 안의 색을 그대로 쓴다: 위는 물, 아래는 모래.
     PARTICLE 밑동에서 물이 떨어져 SANDBOX 윗머리에 반쯤 스민 모양새다.
     · 물 = Water의 `rgb(60, 130, 210)`(#3c82d2). 위쪽은 수면 반사만큼 밝게 띄운다.
     · 모래 = Sand의 `rgb(232, 201, 107)`(#e8c96b).
     · 젖은 모래 = 눈대중이 아니라 렌더러의 겹침 공식 그대로다
       (`CanvasRenderer.wetted` = host 5/8 + fluid 3/8): #a7ae91. 맨 윗줄은
       물이 더 많이 밴 3/8 + 5/8쪽(#7d9dab)이라, 위에서 아래로 갈수록 물기가
       빠져 88%에서 마른 모래가 된다. */
  .line-1 {
    background: linear-gradient(to bottom, #9ccbf5 0%, #5a9ae2 45%, #3c82d2 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .line-2 {
    background: linear-gradient(to bottom, #7d9dab 0%, #a7ae91 24%, #c7bb7e 58%, #e8c96b 88%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .tagline {
    margin: 0.35rem 0 1.6rem 0;
    font-size: 0.95rem;
    color: #94a3b8;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .foot {
    flex: none;
    padding: 1.1rem 1.4rem;
    font-size: 0.72rem;
    color: #475569;
  }

  @media (max-width: 480px) {
    .brand {
      padding: 0.9rem 1rem;
    }
    .tagline {
      font-size: 0.85rem;
      margin-bottom: 1.2rem;
    }
    .foot {
      padding: 0.9rem 1rem;
    }
  }
</style>
